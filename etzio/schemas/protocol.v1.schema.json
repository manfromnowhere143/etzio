{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etzio.local/schemas/protocol.v1.schema.json",
  "title": "Etzio Protocol v1 Semantic Wire Objects",
  "description": "Semantic wire-shape guard for every implemented Etzio protocol-v1 object kind. Typed runtime parsers remain authoritative for canonical bytes, derived identities, cryptography, cross-field and cross-object bindings, aggregate limits, and lifecycle transitions.",
  "x-etzio-schema-role": "semantic_wire_shape_guard",
  "x-etzio-runtime-only-invariants": [
    "canonical UTF-8 JSON spelling, duplicate-key rejection, Unicode 17.0.0 NFC, integer token form, wire bytes, depth, and global node ceilings",
    "content-derived object, claim, trust-snapshot, key, event, and evidence identities",
    "lexical array ordering, field-keyed uniqueness, aggregate collection limits, and cross-field time arithmetic",
    "canonical cryptographic decoding, Ed25519 subgroup validation, signature verification, and signer-to-body binding",
    "nested object equality, retained CAS membership and type, event-chain lifecycle, authority, budget, and concurrency rules"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "object_kind",
    "object_version",
    "object_id",
    "body",
    "attestations"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "object_kind": {
      "type": "string",
      "enum": [
        "analysis_lease",
        "authority_admission",
        "authority_grant",
        "candidate",
        "event",
        "target_snapshot",
        "verification_artifact_resolution",
        "verification_lease",
        "verifier_receipt"
      ]
    },
    "object_version": {
      "type": "integer",
      "const": 1
    },
    "object_id": {
      "$ref": "#/$defs/sha256_id"
    },
    "body": {
      "type": "object"
    },
    "attestations": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/ed25519_attestation"
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/analysis_lease_case"
    },
    {
      "$ref": "#/$defs/authority_admission_case"
    },
    {
      "$ref": "#/$defs/authority_grant_case"
    },
    {
      "$ref": "#/$defs/candidate_case"
    },
    {
      "$ref": "#/$defs/event_case"
    },
    {
      "$ref": "#/$defs/target_snapshot_case"
    },
    {
      "$ref": "#/$defs/verification_artifact_resolution_case"
    },
    {
      "$ref": "#/$defs/verification_lease_case"
    },
    {
      "$ref": "#/$defs/verifier_receipt_case"
    }
  ],
  "$defs": {
    "sha256_id": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "ed25519_key_id": {
      "type": "string",
      "minLength": 79,
      "maxLength": 79,
      "pattern": "^ed25519:sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "epoch_second": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positive_int64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "protocol_string": {
      "type": "string",
      "maxLength": 1000000
    },
    "canonical_nonblank_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000,
      "pattern": "^[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000])?(?![\\s\\S])"
    },
    "lease_nonce_128_hex": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
    },
    "canonical_identity": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}(?![\\s\\S])"
    },
    "snapshot_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^(?!/)(?!\\.\\.?/)(?![\\s\\S]*//)(?![\\s\\S]*/\\.\\.?(?:/|(?![\\s\\S])))(?![\\s\\S]*\\\\)(?![\\s\\S]*\\u0000)(?![\\s\\S]*/(?![\\s\\S]))[\\s\\S]+(?![\\s\\S])"
    },
    "canonical_relative_path": {
      "allOf": [
        {
          "$ref": "#/$defs/snapshot_relative_path"
        },
        {
          "$ref": "#/$defs/canonical_nonblank_string"
        }
      ]
    },
    "ed25519_public_key_b64": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=(?![\\s\\S])"
    },
    "ed25519_signature_b64": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==(?![\\s\\S])"
    },
    "ed25519_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature_b64"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/ed25519_key_id"
        },
        "signature_b64": {
          "$ref": "#/$defs/ed25519_signature_b64"
        }
      }
    },
    "no_attestations": {
      "type": "array",
      "maxItems": 0
    },
    "one_ed25519_attestation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/ed25519_attestation"
      }
    },
    "canonical_actions": {
      "oneOf": [
        {
          "const": []
        },
        {
          "const": [
            "modeled_fixture_verification"
          ]
        },
        {
          "const": [
            "static_analysis"
          ]
        },
        {
          "const": [
            "modeled_fixture_verification",
            "static_analysis"
          ]
        }
      ]
    },
    "canonical_nonempty_actions": {
      "oneOf": [
        {
          "const": [
            "modeled_fixture_verification"
          ]
        },
        {
          "const": [
            "static_analysis"
          ]
        },
        {
          "const": [
            "modeled_fixture_verification",
            "static_analysis"
          ]
        }
      ]
    },
    "evidence_digest_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256_id"
      }
    },
    "envelope_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "object_kind",
        "object_version",
        "object_id",
        "body",
        "attestations"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "object_kind": {
          "type": "string",
          "enum": [
            "analysis_lease",
            "authority_admission",
            "authority_grant",
            "candidate",
            "event",
            "target_snapshot",
            "verification_artifact_resolution",
            "verification_lease",
            "verifier_receipt"
          ]
        },
        "object_version": {
          "type": "integer",
          "const": 1
        },
        "object_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "body": {
          "type": "object"
        },
        "attestations": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/ed25519_attestation"
          }
        }
      }
    },
    "authority_grant_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject",
        "target_snapshot_id",
        "assets",
        "permitted_actions",
        "evidence_digest",
        "issued_at",
        "not_before",
        "expires_at",
        "max_bytes",
        "max_candidates",
        "max_wallclock_seconds"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/canonical_nonblank_string"
        },
        "subject": {
          "$ref": "#/$defs/canonical_nonblank_string"
        },
        "target_snapshot_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_nonblank_string"
          }
        },
        "permitted_actions": {
          "$ref": "#/$defs/canonical_nonempty_actions"
        },
        "evidence_digest": {
          "$ref": "#/$defs/sha256_id"
        },
        "issued_at": {
          "$ref": "#/$defs/epoch_second"
        },
        "not_before": {
          "$ref": "#/$defs/epoch_second"
        },
        "expires_at": {
          "$ref": "#/$defs/epoch_second"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max_wallclock_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "authority_trust_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuers",
        "key_id",
        "public_key_b64",
        "roles"
      ],
      "properties": {
        "issuers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_nonblank_string"
          }
        },
        "key_id": {
          "$ref": "#/$defs/ed25519_key_id"
        },
        "public_key_b64": {
          "$ref": "#/$defs/ed25519_public_key_b64"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_nonblank_string"
          }
        }
      }
    },
    "authority_trust_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "revoked_grant_ids",
        "revoked_key_ids"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/authority_trust_key"
          }
        },
        "revoked_grant_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256_id"
          }
        },
        "revoked_key_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ed25519_key_id"
          }
        }
      }
    },
    "verifier_trust_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "public_key_b64",
        "roles",
        "verifier_id"
      ],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/ed25519_key_id"
        },
        "public_key_b64": {
          "$ref": "#/$defs/ed25519_public_key_b64"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_identity"
          }
        },
        "verifier_id": {
          "$ref": "#/$defs/canonical_identity"
        }
      }
    },
    "verifier_trust_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "revoked_key_ids",
        "revoked_lease_ids",
        "revoked_receipt_ids"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verifier_trust_key"
          }
        },
        "revoked_key_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ed25519_key_id"
          }
        },
        "revoked_lease_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256_id"
          }
        },
        "revoked_receipt_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256_id"
          }
        }
      }
    },
    "unsigned_authority_grant_envelope": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope_frame"
        },
        {
          "properties": {
            "object_kind": {
              "const": "authority_grant"
            },
            "body": {
              "$ref": "#/$defs/authority_grant_body"
            },
            "attestations": {
              "$ref": "#/$defs/no_attestations"
            }
          }
        }
      ]
    },
    "signed_authority_grant_envelope": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope_frame"
        },
        {
          "properties": {
            "object_kind": {
              "const": "authority_grant"
            },
            "body": {
              "$ref": "#/$defs/authority_grant_body"
            },
            "attestations": {
              "$ref": "#/$defs/one_ed25519_attestation"
            }
          }
        }
      ]
    },
    "authority_admission_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "decision_time",
        "grant_expires_at",
        "required_actions",
        "signer_key_id",
        "signed_grant",
        "target_snapshot_id",
        "trust_snapshot",
        "trust_snapshot_id"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "decision_time": {
          "$ref": "#/$defs/epoch_second"
        },
        "grant_expires_at": {
          "$ref": "#/$defs/epoch_second"
        },
        "required_actions": {
          "$ref": "#/$defs/canonical_actions"
        },
        "signer_key_id": {
          "$ref": "#/$defs/ed25519_key_id"
        },
        "signed_grant": {
          "$ref": "#/$defs/signed_authority_grant_envelope"
        },
        "target_snapshot_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "trust_snapshot": {
          "$ref": "#/$defs/authority_trust_snapshot"
        },
        "trust_snapshot_id": {
          "$ref": "#/$defs/sha256_id"
        }
      }
    },
    "snapshot_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "relative_path",
        "size"
      ],
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/sha256_id"
        },
        "relative_path": {
          "$ref": "#/$defs/snapshot_relative_path"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "target_snapshot_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "source"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/snapshot_file"
          }
        },
        "source": {
          "const": "repository_fixture"
        }
      }
    },
    "verification_artifact_type": {
      "type": "string",
      "enum": [
        "modeled_effect_oracle_spec",
        "modeled_environment_spec",
        "modeled_poc_input",
        "modeled_supporting_evidence_input",
        "repository_fixture_source"
      ]
    },
    "verification_artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "artifact_type",
        "size"
      ],
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/sha256_id"
        },
        "artifact_type": {
          "$ref": "#/$defs/verification_artifact_type"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "modeled_poc_artifact_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/verification_artifact_binding"
        },
        {
          "properties": {
            "artifact_type": {
              "const": "modeled_poc_input"
            }
          }
        }
      ]
    },
    "modeled_supporting_evidence_artifact_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/verification_artifact_binding"
        },
        {
          "properties": {
            "artifact_type": {
              "const": "modeled_supporting_evidence_input"
            }
          }
        }
      ]
    },
    "modeled_environment_artifact_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/verification_artifact_binding"
        },
        {
          "properties": {
            "artifact_type": {
              "const": "modeled_environment_spec"
            }
          }
        }
      ]
    },
    "modeled_effect_oracle_artifact_binding": {
      "allOf": [
        {
          "$ref": "#/$defs/verification_artifact_binding"
        },
        {
          "properties": {
            "artifact_type": {
              "const": "modeled_effect_oracle_spec"
            }
          }
        }
      ]
    },
    "verification_target_artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "artifact_type",
        "relative_path",
        "size"
      ],
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/sha256_id"
        },
        "artifact_type": {
          "const": "repository_fixture_source"
        },
        "relative_path": {
          "$ref": "#/$defs/snapshot_relative_path"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "verification_artifact_resolution_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "candidate_id",
        "effect_oracle_artifact",
        "environment_artifact",
        "evidence_artifacts",
        "mission_id",
        "poc_artifact",
        "resolution_profile",
        "resolved_at",
        "target_artifacts",
        "target_snapshot_id",
        "verification_lease_id"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "candidate_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "effect_oracle_artifact": {
          "$ref": "#/$defs/modeled_effect_oracle_artifact_binding"
        },
        "environment_artifact": {
          "$ref": "#/$defs/modeled_environment_artifact_binding"
        },
        "evidence_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modeled_supporting_evidence_artifact_binding"
          }
        },
        "mission_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "poc_artifact": {
          "$ref": "#/$defs/modeled_poc_artifact_binding"
        },
        "resolution_profile": {
          "const": "modeled_fixture_typed_cas_v1"
        },
        "resolved_at": {
          "$ref": "#/$defs/epoch_second"
        },
        "target_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verification_target_artifact_binding"
          }
        },
        "target_snapshot_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "verification_lease_id": {
          "$ref": "#/$defs/sha256_id"
        }
      }
    },
    "analysis_lease_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "authority_id",
        "expires_at",
        "issued_at",
        "lease_nonce",
        "max_bytes",
        "max_candidates",
        "max_wallclock_seconds",
        "mission_id",
        "target_snapshot_id",
        "worker_identity"
      ],
      "properties": {
        "action": {
          "const": "static_analysis"
        },
        "authority_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "expires_at": {
          "$ref": "#/$defs/epoch_second"
        },
        "issued_at": {
          "$ref": "#/$defs/epoch_second"
        },
        "lease_nonce": {
          "$ref": "#/$defs/lease_nonce_128_hex"
        },
        "max_bytes": {
          "$ref": "#/$defs/positive_int64"
        },
        "max_candidates": {
          "$ref": "#/$defs/positive_int64"
        },
        "max_wallclock_seconds": {
          "$ref": "#/$defs/positive_int64"
        },
        "mission_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "target_snapshot_id": {
          "$ref": "#/$defs/sha256_id"
        },
        "worker_identity": {
          "const": "VELITES"
        }
      }
    },
    "candidate_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_lease_id",
        "analyzer_version",
        "authority_id",
        "claim_id",
        "column",
        "line",
        "mission_id",
        "producer_identity",
        "relative_path",
        "rule_id",
